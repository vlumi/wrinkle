{
  "name": "wrinkle-ts",
  "version": "0.1.0",
  "private": true,
  "description": "The Wrinkle TypeScript backend: gateway, services and fan-out on Node.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@node-rs/argon2": "^2.2.2",
    "mysql2": "^3.24.6",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
