#!/bin/bash
# Runs the TypeScript backend; flags as for the Go binary (--roles, --listen, ...).
# --expose-gc lets POST /debug/gc collect before a measurement samples memory.
# Password hashes take up to one thread pool thread per core; the pool keeps
# libuv's default four beside them for DNS and file work.
set -euo pipefail
dir=$(cd "$(dirname "$0")" && pwd)
export UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-$(($(getconf _NPROCESSORS_ONLN) + 4))}
exec node --expose-gc "$dir/src/main.ts" "$@"
