# Local settings, not committed: copy to .env at the repository root.
# Every full backend (Go, Java, TypeScript) reads it at startup, the cluster
# passes it to the containers (infra/cluster.sh), and the iOS scripts take the
# team from it.

# Apple developer team: signs the iOS app and the APNs provider token.
WRINKLE_TEAM_ID=

# APNs key (.p8) from the developer account, Keys, with "Apple Push
# Notifications service" enabled. Not an App Store Connect API key. Push
# notifications are off when this is empty. The key id is read from the file
# name AuthKey_<id>.p8; set WRINKLE_APNS_KEY_ID if the file was renamed.
WRINKLE_APNS_KEY=
# WRINKLE_APNS_KEY_ID=
