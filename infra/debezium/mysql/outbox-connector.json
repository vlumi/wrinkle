{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "topic.prefix": "wrinkle",
  "database.hostname": "mysql",
  "database.port": "15003",
  "database.user": "root",
  "database.password": "",
  "database.server.id": "101",
  "database.include.list": "conversation",
  "table.include.list": "conversation.outbox",
  "snapshot.mode": "no_data",
  "include.schema.changes": "false",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "wrinkle.schema-history.conversation",
  "schema.history.internal.store.only.captured.tables.ddl": "true",
  "custom.metric.tags": "connector=wrinkle-outbox",
  "poll.interval.ms": "20",
  "skipped.operations": "u,d,t",
  "message.key.columns": "conversation.outbox:conversation_id",
  "transforms": "unwrap",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.drop.tombstones": "true",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false"
}
